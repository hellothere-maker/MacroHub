local nextRenderTime = 0
local nextPreRenderTime = 0
local maxClicksPerFrame = 100
local posCycleIndex = 0

local targetCPS = 700
local minCPS = 1
local maxCPS = 2500

local isDraggingSlider = false

local posOffsets = {
	Vector2.new(0, 0), Vector2.new(1, 0), Vector2.new(0, 1), Vector2.new(1, 1),
	Vector2.new(-1, 0), Vector2.new(0, -1), Vector2.new(-1, -1), Vector2.new(2, 0),
	Vector2.new(2, 1), Vector2.new(1, 2), Vector2.new(-2, 0), Vector2.new(0, -2),
	Vector2.new(-1, 1), Vector2.new(1, -1), Vector2.new(-2, -1), Vector2.new(2, -1)
}

local function fireBlockClick()
	if blockClickX == 0 and blockClickY == 0 then return end
	posCycleIndex = (posCycleIndex % 16) + 1
	local offset = posOffsets[posCycleIndex]
	local mX = blockClickX + offset.X
	local mY = blockClickY + offset.Y
	pcall(function()
		VIM:SendMouseButtonEvent(mX, mY, 0, true, game, 0)
		VIM:SendMouseButtonEvent(mX, mY, 0, false, game, 0)
	end)
end

local function burstBlockClicks(count)
	for i = 1, count do
		fireBlockClick()
		totalClicks = totalClicks + 1
	end
end

local function updateSliderVisuals()
	local percent = (targetCPS - minCPS) / (maxCPS - minCPS)
	sliderFill.Size = UDim2.new(percent, 0, 1, 0)
	sliderKnob.Position = UDim2.new(percent, -7, 0.5, -7)
	cpsTargetLabel.Text = "target: " .. tostring(targetCPS)
end

local function handleSliderDrag()
	local mousePos = UIS:GetMouseLocation()
	local sliderAbsPos = sliderBg.AbsolutePosition
	local sliderAbsSize = sliderBg.AbsoluteSize
	local rawWidth = sliderAbsSize.X
	if rawWidth <= 0 then return end
	local offsetX = mousePos.X - sliderAbsPos.X
	local relativeX = math.clamp(offsetX / rawWidth, 0, 1)
	targetCPS = math.floor(minCPS + ((maxCPS - minCPS) * relativeX))
	targetCPS = math.clamp(targetCPS, minCPS, maxCPS)
	updateSliderVisuals()
end

sliderKnob.MouseButton1Down:Connect(function()
	isDraggingSlider = true
	handleSliderDrag()
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		isDraggingSlider = false
	end
end)

UIS.InputChanged:Connect(function(input)
	if isDraggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
		handleSliderDrag()
	end
end)

sliderBg.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		isDraggingSlider = true
		handleSliderDrag()
	end
end)

keybindBtn.MouseButton1Click:Connect(function()
	waitingForBind = "activation"
	keybindBtn.Text = "..."
	keybindBtn.TextColor3 = Color3.fromRGB(255, 200, 100)
	local connection
	connection = UIS.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if waitingForBind == "activation" and input.UserInputType == Enum.UserInputType.Keyboard then
			activationKey = input.KeyCode
			keybindBtn.Text = activationKey.Name
			keybindBtn.TextColor3 = Color3.fromRGB(200, 200, 230)
			waitingForBind = nil
			connection:Disconnect()
			CAS:UnbindAction(clickActionName)
			bindClickAction()
		end
	end)
end)

local function refreshCPSDisplay()
	local timeNow = tick()
	local deltaTime = timeNow - lastTimeChecked
	if deltaTime >= 0.1 then
		calculatedCPS = totalClicks / deltaTime
		table.insert(cpsHistoryTable, calculatedCPS)
		if #cpsHistoryTable > 10 then
			table.remove(cpsHistoryTable, 1)
		end
		local smoothCPS = 0
		for i = 1, #cpsHistoryTable do
			smoothCPS = smoothCPS + cpsHistoryTable[i]
		end
		smoothCPS = smoothCPS / #cpsHistoryTable
		if smoothCPS > maxCPSRecorded then
			maxCPSRecorded = smoothCPS
		end
		totalClicks = 0
		lastTimeChecked = timeNow
		local displayValue = math.floor(smoothCPS + 0.5)
		cpsValue.Text = tostring(displayValue)
		cpsActualLabel.Text = "actual: " .. tostring(displayValue)
		local percentToTarget = smoothCPS / targetCPS
		if percentToTarget >= 0.92 then
			cpsValue.TextColor3 = Color3.fromRGB(100, 220, 100)
		elseif percentToTarget >= 0.65 then
			cpsValue.TextColor3 = Color3.fromRGB(100, 190, 255)
		else
			cpsValue.TextColor3 = Color3.fromRGB(255, 160, 100)
		end
	end
end

local function cpsUpdateLoopFunction()
	while isClickingActive do
		refreshCPSDisplay()
		local percentForBar = math.clamp(calculatedCPS / targetCPS, 0, 1)
		smoothMove(progressFill, {Size = UDim2.new(percentForBar, 0, 1, 0)}, 0.04)
		task.wait(0.05)
	end
end

local function heartbeatBurst()
	if not isClickingActive then return end
	local now = tick()
	if now >= nextHeartbeatTime then
		local diff = now - nextHeartbeatTime
		local interval = 1.0 / (targetCPS / 3)
		local needed = math.floor(diff / interval) + 1
		needed = math.clamp(needed, 1, maxClicksPerFrame)
		burstBlockClicks(needed)
		nextHeartbeatTime = nextHeartbeatTime + (needed * interval)
		if nextHeartbeatTime <= now then
			nextHeartbeatTime = now + interval
		end
	end
end

local function renderBurst()
	if not isClickingActive then return end
	local now = tick()
	if now >= nextRenderTime then
		local diff = now - nextRenderTime
		local interval = 1.0 / (targetCPS / 3)
		local needed = math.floor(diff / interval) + 1
		needed = math.clamp(needed, 1, maxClicksPerFrame)
		burstBlockClicks(needed)
		nextRenderTime = nextRenderTime + (needed * interval)
		if nextRenderTime <= now then
			nextRenderTime = now + interval
		end
	end
end

local function preRenderBurst()
	if not isClickingActive then return end
	local now = tick()
	if now >= nextPreRenderTime then
		local diff = now - nextPreRenderTime
		local interval = 1.0 / (targetCPS / 3)
		local needed = math.floor(diff / interval) + 1
		needed = math.clamp(needed, 1, maxClicksPerFrame)
		burstBlockClicks(needed)
		nextPreRenderTime = nextPreRenderTime + (needed * interval)
		if nextPreRenderTime <= now then
			nextPreRenderTime = now + interval
		end
	end
end

local function startTheClicking()
	if isClickingActive then return end
	isClickingActive = true
	totalClicks = 0
	lastTimeChecked = tick()
	calculatedCPS = 0
	maxCPSRecorded = 0
	cpsHistoryTable = {}
	nextHeartbeatTime = tick()
	nextRenderTime = tick()
	nextPreRenderTime = tick()
	posCycleIndex = 0
	maxClicksPerFrame = math.clamp(math.ceil(targetCPS / 18), 1, 150)
	cpsValue.Text = "0"
	cpsValue.TextColor3 = Color3.fromRGB(100, 190, 255)
	heartbeatConn = RunService.Heartbeat:Connect(heartbeatBurst)
	renderConn = RunService.RenderStepped:Connect(renderBurst)
	preRenderConn = RunService.PreRender:Connect(preRenderBurst)
	cpsUpdaterThread = task.spawn(cpsUpdateLoopFunction)
	smoothMove(draggableStroke, {Transparency = 0.3, Color = Color3.fromRGB(100, 190, 255)}, 0.08)
end

local function stopTheClicking()
	if not isClickingActive then return end
	isClickingActive = false
	if heartbeatConn then heartbeatConn:Disconnect() heartbeatConn = nil end
	if renderConn then renderConn:Disconnect() renderConn = nil end
	if preRenderConn then preRenderConn:Disconnect() preRenderConn = nil end
	if cpsUpdaterThread then task.cancel(cpsUpdaterThread) cpsUpdaterThread = nil end
	task.wait(0.05)
	cpsValue.Text = tostring(math.floor(maxCPSRecorded + 0.5))
	smoothMove(progressFill, {Size = UDim2.new(0, 0, 1, 0)}, 0.2)
	smoothMove(draggableStroke, {Transparency = 0.7, Color = Color3.fromRGB(255, 255, 255)}, 0.15)
end

local function onMacroAction(actionName, inputState, inputObject)
	if inputState == Enum.UserInputState.Begin then
		startTheClicking()
	elseif inputState == Enum.UserInputState.End then
		stopTheClicking()
	end
end

local function bindClickAction()
	CAS:BindAction(clickActionName, onMacroAction, false, activationKey)
end

bindClickAction()

