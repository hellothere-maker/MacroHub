local posOffsets = {
	Vector2.new(0, 0), Vector2.new(1, 0), Vector2.new(0, 1), Vector2.new(1, 1),
	Vector2.new(-1, 0), Vector2.new(0, -1), Vector2.new(-1, -1), Vector2.new(2, 0),
	Vector2.new(2, 1), Vector2.new(1, 2), Vector2.new(-2, 0), Vector2.new(0, -2),
	Vector2.new(-1, 1), Vector2.new(1, -1), Vector2.new(-2, -1), Vector2.new(2, -1)
}
local posCycleIndex = 0

-- -------------------------------------------
local function fireBlockClick(count)
	if blockClickX == 0 and blockClickY == 0 then return end
	posCycleIndex = (posCycleIndex % 16) + 1
	local offset = posOffsets[posCycleIndex]
	pcall(function()
		VirtualInputManager:SendMouseButtonEvent(blockClickX + offset.X, blockClickY + offset.Y, 0, true, game, count)
		VirtualInputManager:SendMouseButtonEvent(blockClickX + offset.X, blockClickY + offset.Y, 0, false, game, count)
	end)
end

-- -------------------------------------------
local function updateSliderVisuals()
	local percent = (targetCPS - minCPS) / (maxCPS - minCPS)
	sliderFill.Size = UDim2.new(percent, 0, 1, 0)
	sliderKnob.Position = UDim2.new(percent, -7, 0.5, -7)
	cpsTargetLabel.Text = "CPS: " .. tostring(targetCPS)
	cpsActualLabel.Text = "CPS: " .. tostring(targetCPS)
	cpsValue.Text = tostring(targetCPS)
end

-- -------------------------------------------
local function dragSlider()
	local mousePos = UserInputService:GetMouseLocation()
	local sliderAbsPos = sliderBg.AbsolutePosition
	local sliderAbsSize = sliderBg.AbsoluteSize
	local rawWidth = sliderAbsSize.X
	if rawWidth <= 0 then return end
	local offsetX = mousePos.X - sliderAbsPos.X
	local relativeX = math.clamp(offsetX / rawWidth, 0, 1)
	targetCPS = math.floor(minCPS + ((maxCPS - minCPS) * relativeX))
	targetCPS = math.clamp(targetCPS, minCPS, maxCPS)
	updateSliderVisuals()
end

-- -------------------------------------------
sliderKnob.MouseButton1Down:Connect(function()
	isDraggingSlider = true
	dragSlider()
end)

-- -------------------------------------------
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		isDraggingSlider = false
	end
end)

-- -------------------------------------------
UserInputService.InputChanged:Connect(function(input)
	if isDraggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
		dragSlider()
	end
end)

-- -------------------------------------------
sliderBg.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		isDraggingSlider = true
		dragSlider()
	end
end)

-- -------------------------------------------
local function macroLoop()
	local interval = 1.0 / targetCPS
	local nextTime = tick()
	while isClickingActive and not GuiDestroyed do
		local now = tick()
		if now >= nextTime then
			local missed = math.floor((now - nextTime) / interval) + 1
			missed = math.clamp(missed, 1, 200)
			fireBlockClick(missed)
			nextTime = nextTime + (missed * interval)
			if nextTime <= now then
				nextTime = now + interval
			end
		end
		RunService.RenderStepped:Wait()
	end
end

-- -------------------------------------------
local function startTheClicking()
	if GuiDestroyed then return end
	if isClickingActive then return end
	isClickingActive = true
	updateSliderVisuals()
	cpsValue.TextColor3 = Color3.fromRGB(100, 220, 100)
	macroConnection = task.spawn(macroLoop)
	smoothMove(draggableStroke, {Transparency = 0.3, Color = Color3.fromRGB(100, 190, 255)}, 0.08)
	smoothMove(progressFill, {Size = UDim2.new(1, 0, 1, 0)}, 0.08)
end

-- -------------------------------------------
local function stopTheClicking()
	if not isClickingActive then return end
	isClickingActive = false
	if macroConnection then task.cancel(macroConnection) macroConnection = nil end
	cpsValue.Text = tostring(targetCPS)
	cpsValue.TextColor3 = Color3.fromRGB(100, 190, 255)
	smoothMove(progressFill, {Size = UDim2.new(0, 0, 1, 0)}, 0.2)
	smoothMove(draggableStroke, {Transparency = 0.7, Color = Color3.fromRGB(255, 255, 255)}, 0.15)
end

-- -------------------------------------------
local function onMacroAction(actionName, inputState, inputObject)
	if inputState == Enum.UserInputState.Begin then
		startTheClicking()
	elseif inputState == Enum.UserInputState.End then
		stopTheClicking()
	end
end

-- -------------------------------------------
local function bindMacroAction()
	ContextActionService:BindActionAtPriority(macroActionName, onMacroAction, false, 10000, Enum.KeyCode.F)
	ContextActionService:SetTitle(macroActionName, "MacroClash")
	ContextActionService:SetDescription(macroActionName, "hold to spam")
end

-- -------------------------------------------
bindMacroAction()

-- -------------------------------------------
local function DestroyEverything()
	GuiDestroyed = true
	stopTheClicking()
	ContextActionService:UnbindAction(macroActionName)
	xX_mainGuiHolder_Xx:Destroy()
end

-- -------------------------------------------
local isDraggingFrame = false
local dragStartPos, frameStartPos

-- -------------------------------------------
dragBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		isDraggingFrame = true
		dragStartPos = input.Position
		frameStartPos = draggable.Position
		smoothMove(draggable, {BackgroundTransparency = 0.05}, 0.08)
	end
end)

-- -------------------------------------------
dragBar.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 and isDraggingFrame then
		isDraggingFrame = false
		smoothMove(draggable, {BackgroundTransparency = 0.12}, 0.08)
	end
end)

-- -------------------------------------------
UserInputService.InputChanged:Connect(function(input)
	if isDraggingFrame and input.UserInputType == Enum.UserInputType.MouseMovement then
		local movementDiff = input.Position - dragStartPos
		draggable.Position = UDim2.new(
			frameStartPos.X.Scale,
			frameStartPos.X.Offset + movementDiff.X,
			frameStartPos.Y.Scale,
			frameStartPos.Y.Offset + movementDiff.Y
		)
	end
end)

-- -------------------------------------------
local function showConfirmPopup()
	confirmOverlay.Visible = true
	smoothMove(confirmOverlay, {BackgroundTransparency = 0.3}, 0.15)
	smoothMove(confirmPopup, {BackgroundTransparency = 0.4, Size = UDim2.new(0, 220, 0, 60)}, 0.2, Enum.EasingStyle.Elastic)
	smoothMove(confirmPopupStroke, {Transparency = 0.3}, 0.2)
	smoothMove(confirmLabel, {TextTransparency = 0}, 0.2)
	smoothMove(confirmYes, {TextTransparency = 0, BackgroundTransparency = 1}, 0.2)
	smoothMove(confirmNo, {TextTransparency = 0, BackgroundTransparency = 1}, 0.2)
end

-- -------------------------------------------
local function hideConfirmPopup()
	smoothMove(confirmOverlay, {BackgroundTransparency = 1}, 0.1)
	smoothMove(confirmPopup, {BackgroundTransparency = 1}, 0.1)
	smoothMove(confirmPopupStroke, {Transparency = 1}, 0.1)
	smoothMove(confirmLabel, {TextTransparency = 1}, 0.1)
	smoothMove(confirmYes, {TextTransparency = 1, BackgroundTransparency = 1}, 0.1)
	smoothMove(confirmNo, {TextTransparency = 1, BackgroundTransparency = 1}, 0.1)
	task.wait(0.1)
	confirmOverlay.Visible = false
end

-- -------------------------------------------
closeBtn.MouseButton1Click:Connect(function()
	showConfirmPopup()
end)

-- -------------------------------------------
confirmYes.MouseButton1Click:Connect(function()
	hideConfirmPopup()
	task.wait(0.1)
	DestroyEverything()
end)

-- -------------------------------------------
confirmNo.MouseButton1Click:Connect(function()
	hideConfirmPopup()
end)

