local function smoothMove(obj, props, dur, style)
	local tInfo = TweenInfo.new(dur, style or Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
	local tweens = TweenService:Create(obj, tInfo, props)
	tweens:Play()
	return tweens
end

