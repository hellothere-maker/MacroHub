local function fadeInAll()
	smoothMove(draggable, {BackgroundTransparency = 0.12, Position = UDim2.new(0.35, 0, 0.25, 0)}, 0.35, Enum.EasingStyle.Quart)
	smoothMove(draggableStroke, {Transparency = 0.7}, 0.35)
	smoothMove(divider1, {BackgroundTransparency = 0.6}, 0.35)
	smoothMove(CPSbox, {BackgroundTransparency = 0.5}, 0.35)
	smoothMove(CPSboxStroke, {Transparency = 0.75}, 0.35)
	smoothMove(clicking, {BackgroundTransparency = 0.5}, 0.35)
	smoothMove(clickingStroke, {Transparency = 0.75}, 0.35)
	smoothMove(setkeybind, {BackgroundTransparency = 0.5}, 0.35)
	smoothMove(setkeybindStroke, {Transparency = 0.75}, 0.35)
	smoothMove(progressBg, {BackgroundTransparency = 0.6}, 0.35)
	smoothMove(creditsFrame, {BackgroundTransparency = 0.5}, 0.35)
	smoothMove(creditsStroke, {Transparency = 0.75}, 0.35)
	smoothMove(sliderBg, {BackgroundTransparency = 0.6}, 0.35)
	smoothMove(sliderKnob, {BackgroundTransparency = 0}, 0.35)
	smoothMove(sliderKnobStroke, {Transparency = 0}, 0.35)
	smoothMove(keybindBtn, {BackgroundTransparency = 1}, 0.35)
	smoothMove(closeBtn, {BackgroundTransparency = 1}, 0.35)
	smoothMove(dragBar, {BackgroundTransparency = 0.95}, 0.35)
	for _, child in ipairs(draggable:GetDescendants()) do
		if child:IsA("TextLabel") or child:IsA("TextButton") then
			if child.Parent ~= confirmOverlay and child.Parent ~= confirmPopup then
				smoothMove(child, {TextTransparency = 0}, 0.3)
			end
		end
	end
end

-- -------------------------------------------
local function LoadUI()
	draggable.Visible = true
	draggable.BackgroundTransparency = 1
	draggable.Position = UDim2.new(0.35, 0, 0.12, -200)
	updateSliderVisuals()
	fadeInAll()
end

